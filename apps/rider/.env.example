# Copy to .env.local. Expo inlines EXPO_PUBLIC_* vars into the app bundle.
# Get the local anon key from `pnpm db:status`.
#
# iOS simulator: http://127.0.0.1:54321
# Android emulator: http://10.0.2.2:54321
# Physical device (Expo Go): http://<your-machine-LAN-IP>:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Address search — free key at https://cloud.maptiler.com/account/keys/
EXPO_PUBLIC_MAPTILER_KEY=
