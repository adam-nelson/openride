    "clean": "rm -rf .expo dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@openride/api-client": "workspace:*",
    "@openride/db": "workspace:*",
    "@openride/realtime": "workspace:*",
    "@openride/ui": "workspace:*",
    "@react-navigation/native": "^7.3.0",
    "@react-navigation/native-stack": "^7.17.0",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~56.0.0",
    "expo-constants": "~56.0.17",
    "expo-linking": "~56.0.13",
    "expo-location": "~56.0.16",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-url-polyfill": "^2.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
