{
  "name": "@openride/driver",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
