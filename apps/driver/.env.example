# Copy to .env.local. Expo inlines EXPO_PUBLIC_* vars into the app bundle.
# Get the local anon key from `pnpm db:status`.
# The web dev bundle uses Metro's same-origin /supabase proxy. This private
# target is read only by Metro and is never inlined into the browser bundle.
#
# iOS simulator: http://127.0.0.1:54321
# Android emulator: http://10.0.2.2:54321
# Physical device (Expo Go): http://<your-machine-LAN-IP>:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_LOCAL_SUPABASE_URL=http://127.0.0.1:54321
