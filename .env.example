# Copy to .env.local and fill in. Never commit the real .env.

# ---- Supabase (required) ----
# Local dev defaults are set by `supabase start`; values below are the local defaults.
# NOTE: the Next.js admin app does NOT read this root file — it reads its own
# apps/admin/.env.local (Next only loads env files from the app directory).
# See apps/admin/.env.example.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOi...replace-after-supabase-start
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...replace-after-supabase-start

# ---- Stripe (required for payments; use test keys until launch) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# ---- Twilio (required for phone OTP via Supabase Auth) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# For staging/prod, edit infra/supabase/config.toml to use
# auth_token = "env(SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN)" and set this var.
# Local dev keeps a hardcoded dummy in config.toml — [auth.sms.test_otp]
# intercepts before any real Twilio call.
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# ---- Expo / EAS ----
EXPO_ACCESS_TOKEN=
EAS_PROJECT_ID=

# ---- Maps & routing ----
MAPTILER_KEY=
# OR self-hosted Protomaps:
# TILES_BASE_URL=https://tiles.example.com
VALHALLA_BASE_URL=http://localhost:8002

# ---- Email ----
RESEND_API_KEY=

# ---- App URLs / deeplinks ----
ADMIN_BASE_URL=http://localhost:3000
RIDER_DEEPLINK_PREFIX=openride-rider://
DRIVER_DEEPLINK_PREFIX=openride-driver://

# ---- Operator (single-tenant MVP) ----
OPERATOR_NAME=Ridge Co-op
OPERATOR_COUNTRY=AU
OPERATOR_CURRENCY=AUD
OPERATOR_TIMEZONE=Australia/Sydney
OPERATOR_STATE=NSW
