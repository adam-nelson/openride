# Env — ignore every .env variant (.env, .env.local, .env.production, …)
# but keep the committed, secret-free templates.
.env
.env.*
!.env.example
!**/.env.example

# Secrets & credentials — never commit real keys/certs/tokens.
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
id_rsa
id_ed25519
*service-account*.json
gha-creds-*.json
secrets.json
*.secret
.secrets/
# Supabase CLI local secrets / generated env
infra/supabase/.env
google-services.json
GoogleService-Info.plist

# Supabase
infra/supabase/.branches/
infra/supabase/.temp/
supabase/.branches/
# Stray CLI scaffold if `supabase` is ever run from the repo root without --workdir.
# The real project config lives in infra/supabase.
/supabase/

# This is a pnpm workspace — never commit an npm lockfile.
package-lock.json

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo

